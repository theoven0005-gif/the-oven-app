<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white"
    tools:context=".ItemCustomizationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Customize Your Order"
            app:titleTextColor="@color/charcoal_black" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Item Image Placeholder -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEEEEE">

                <ImageView
                    android:id="@+id/imgItem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pizza_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fajita Sensation Pizza"
                android:textColor="@color/charcoal_black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Delicious chicken fajita, onions, green peppers, and a special blend of mozzarella cheese."
                android:textColor="#757575"
                android:textSize="14sp" />

            <!-- Size Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Select Size"
                android:textColor="@color/charcoal_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/selector_chip"
                    android:text="Small"
                    android:textAlignment="center"
                    android:padding="8dp"
                    android:textColor="@color/selector_chip_text"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/selector_chip"
                    android:text="Medium"
                    android:textAlignment="center"
                    android:padding="8dp"
                    android:textColor="@color/selector_chip_text" />

                <RadioButton
                    android:id="@+id/rbLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:background="@drawable/selector_chip"
                    android:text="Large"
                    android:textAlignment="center"
                    android:padding="8dp"
                    android:textColor="@color/selector_chip_text" />

            </RadioGroup>

            <!-- Crust Style -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Crust Style"
                android:textColor="@color/charcoal_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCrust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbHandTossed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Classic Hand-Tossed"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbThinCrust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thin &amp; Crispy" />

                <RadioButton
                    android:id="@+id/rbDeepPan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deep Pan" />

            </RadioGroup>

            <!-- Extra Toppings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Extra Toppings"
                android:textColor="@color/charcoal_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbExtraCheese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Extra Cheese (+ Rs. 150)" />

            <CheckBox
                android:id="@+id/cbMushrooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mushrooms (+ Rs. 100)" />

            <CheckBox
                android:id="@+id/cbOlives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Black Olives (+ Rs. 80)" />

            <CheckBox
                android:id="@+id/cbOnions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caramelized Onions (+ Rs. 50)" />

            <!-- Spacer to not hide content behind the button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToCart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:text="Add to Cart - Rs. 1,250"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/mint_teal"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>