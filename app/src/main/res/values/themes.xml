<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TheOven" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/mint_teal</item>
        <item name="colorPrimaryVariant">@color/mint_teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/crimson_red</item>
        <item name="colorSecondaryVariant">@color/crimson_red</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/charcoal_black</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/mint_teal</item>
        <item name="android:windowBackground">@color/warm_white</item>

        <!-- Explicit text colors to prevent purple -->
        <item name="android:textColorPrimary">@color/charcoal_black</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
        <item name="android:editTextColor">@color/charcoal_black</item>

        <!-- Prevent purple on buttons and chips -->
        <item name="materialButtonStyle">@style/CustomButtonStyle</item>
        <item name="chipStyle">@style/CustomChipStyle</item>
    </style>

    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mint_teal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/white</item>
        <item name="android:textColor">@color/charcoal_black</item>
        <item name="chipStrokeColor">@color/mint_teal</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <style name="Theme.TheOven" parent="Base.Theme.TheOven" />

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/charcoal_black</item>
    </style>
</resources>