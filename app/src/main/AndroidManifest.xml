<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TheOvenApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheOven">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Login" />

        <activity
            android:name=".ItemCustomizeActivity"
            android:exported="false"
            android:label="Customize Item" />

        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:label="Your Cart" />

        <activity
            android:name=".TrackerActivity"
            android:exported="false"
            android:label="Track Order" />

        <activity
            android:name=".OrderSuccessActivity"
            android:exported="false"
            android:label="Order Successful" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="Home" />

        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="Menu" />

        <activity
            android:name=".DealsActivity"
            android:exported="false"
            android:label="Deals" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="Profile" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:label="Edit Profile" />

        <activity
            android:name=".OrdersActivity"
            android:exported="false"
            android:label="My Orders" />

        <activity
            android:name=".AddressesActivity"
            android:exported="false"
            android:label="Saved Addresses" />

        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:label="Payment Details" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".FullMenuActivity"
            android:exported="false"
            android:label="Full Menu" />

        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>